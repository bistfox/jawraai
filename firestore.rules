rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Grant admin access if the user's verified email is the admin email.
      return request.auth.token.email_verified && request.auth.token.email == 'lofeelzone@gmail.com';
    }

    match /users/{userId} {
      // Allow user to read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow user to create their profile, but subscription must be 'free'
      allow create: if request.auth.uid == userId 
                    && request.resource.data.subscription == 'free';
      
      // Allow user to update their profile, but they cannot change their subscription status
      // Admins can update any user's profile
      allow update: if (request.auth.uid == userId 
                    && request.resource.data.subscription == resource.data.subscription) || isAdmin();

      // Allow user to delete their own profile
      allow delete: if request.auth.uid == userId;
    }

    match /users/{userId}/chats/{chatId=**} {
      allow read, write: if request.auth.uid == userId;
    }
    
    match /subscription_requests/{requestId} {
      // User can create their own subscription request
      allow create: if request.auth.uid == request.resource.data.userId;
      
      // User can read their own requests to check status, admins can read all
      allow read: if request.auth.uid == resource.data.userId || isAdmin();

      // Admins can list, update, and delete requests
      allow list, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
